{
  "name": "@skilleddragon/minilab-ocr-scion-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkilledDragon minilab: Scion-scale PR review gate with Open Code Review",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3",
  "bin": {
    "ocr-scion-review": "./src/cli.ts"
  },
  "scripts": {
    "review": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node --outfile dist/cli.js",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "bun x @biomejs/biome check .",
    "lint:fix": "bun x @biomejs/biome check --write .",
    "check:skills": "bun run scripts/check-skills.ts",
    "check:banned": "bun run scripts/check-banned.ts",
    "extract:upstream": "bun run scripts/extract-upstream-steps.ts",
    "check:upstream-parity": "bun run scripts/check-upstream-parity.ts",
    "ensure:ocr": "bun run scripts/ensure-ocr-binary.ts",
    "upstream:local": "bash scripts/upstream-test.sh",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "1.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "5.9.3",
    "yaml": "2.8.2"
  }
}
