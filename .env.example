# Optional live LLM review (keyless path needs none of these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_RESPONSES_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
AWS_REGION=
AWS_PROFILE=

# OCR / LLM overrides used by upstream open-code-review
OCR_BINARY=
OCR_LLM_URL=
OCR_LLM_TOKEN=
OCR_LLM_MODEL=
OCR_LLM_PROTOCOL=
OCR_LLM_AUTH_HEADER=
OCR_LLM_EXTRA_HEADERS=
OCR_LLM_TIMEOUT=
OCR_USE_ANTHROPIC=
OCR_DELEGATE_REQUIRE_PTY=
OCR_ENABLE_TELEMETRY=
OCR_CONTENT_LOGGING=
OCR_GIT_BIN=

# OpenTelemetry (only when OCR_ENABLE_TELEMETRY=1)
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
TRACEPARENT=

# Misc provider keys recognized by upstream presets
DASHSCOPE_TOKENPLAN_KEY=
AWS_BEARER_TOKEN_BEDROCK=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

DO_NOT_TRACK=1
